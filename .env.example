# Copy to .env and change JWT_SECRET; never commit .env.
JWT_SECRET=change-this-to-a-long-random-secret
# Default real free/local mode (requires Ollama running):
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=qwen2.5:3b
# Alternate free-tier hosted provider: LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Real semantic vectors (downloads model once on first use):
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Embedded Qdrant (no Docker needed):
VECTOR_STORE=qdrant
QDRANT_PATH=data/qdrant
COLLECTION_NAME=company_policies
DOCS_DIR=docs
TOP_K=5
MAX_QUESTION_CHARS=2000
REQUEST_TIMEOUT_SECONDS=90
# Test/demo only; not a real LLM or semantic retriever:
# LLM_PROVIDER=mock
# EMBEDDING_PROVIDER=hashing
# VECTOR_STORE=sqlite
# SQLITE_PATH=data/chunks.sqlite3
